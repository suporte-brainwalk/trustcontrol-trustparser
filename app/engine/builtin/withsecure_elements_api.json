{
 "slug": "withsecure-elements-api-event",
 "name": "WithSecure Elements · evento de segurança da API (JSON)",
 "vendor": "WithSecure",
 "product": "Elements Endpoint Protection",
 "description": "Um item de items[] de POST /security-events/v1/security-events (Elements API) — ou o formato por tipo de evento da especificação (account/tenant, datas em epoch ms) — serializado em uma linha. Usa a mesma semântica do parser syslog do WithSecure (eventos Windows 4625/conta/grupo, controle de aplicativo, conteúdo web, controle de dispositivo, malware) e acrescenta firewall (Network Activity), DeepGuard/AMSI e incidentes EDR (Detection Finding). Feito pela documentação (exemplos do OpenAPI) — validar com resposta real.",
 "basis": "docs",
 "priority": 100,
 "detect": {
  "all": [
   {
    "re": "^\\s*\\{"
   },
   {
    "contains": "\"engine\""
   },
   {
    "contains": "\"details\""
   },
   {
    "any": [
     {
      "contains": "\"serverTimestamp\""
     },
     {
      "contains": "\"persistenceTimestamp\""
     },
     {
      "contains": "\"clientTimestamp\""
     }
    ]
   }
  ]
 },
 "steps": [
  {
   "op": "json",
   "from": "$raw",
   "to": "j"
  },
  {
   "op": "set",
   "to": "d",
   "value": "j.details"
  },
  {
   "op": "mojibake",
   "paths": [
    "d"
   ]
  },
  {
   "op": "winxml",
   "from": "d.eventXml",
   "to": "win",
   "optional": true
  },
  {
   "op": "set",
   "to": "hostips",
   "value": {
    "path": "d.hostIpAddress",
    "type": "ips"
   }
  },
  {
   "op": "set",
   "to": "user_raw",
   "value": {
    "first": [
     {
      "path": "d.userName",
      "type": "nil"
     },
     {
      "path": "j.userName",
      "type": "nil"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "evtype",
   "value": {
    "template": "{j.engine}.{j.action}",
    "strict": true
   }
  },
  {
   "op": "set",
   "to": "devid",
   "value": {
    "first": [
     {
      "regex": "^([0-9A-Fa-f]{8}-[0-9A-Fa-f-]{27})$",
      "path": "j.device.id"
     },
     "j.device.agentId",
     "j.target.id"
    ]
   }
  },
  {
   "op": "set",
   "to": "devname",
   "value": {
    "first": [
     "j.device.name",
     "j.target.name",
     "d.systemDataComputer"
    ]
   }
  },
  {
   "op": "set",
   "to": "orgname",
   "value": {
    "first": [
     "j.organization.name",
     "j.account.name"
    ]
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "d.clientTimestamp",
     "type": "epoch_ms"
    },
    {
     "path": "j.clientTimestamp",
     "type": "time"
    },
    {
     "path": "win.System.TimeCreatedSystemTime",
     "type": "time"
    },
    {
     "path": "d.systemDataTimeCreated",
     "type": "epoch_s"
    },
    {
     "path": "j.serverTimestamp",
     "type": "time"
    },
    {
     "path": "j.persistenceTimestamp",
     "type": "time"
    }
   ]
  },
  "metadata.logged_time": {
   "first": [
    {
     "path": "j.persistenceTimestamp",
     "type": "time"
    },
    {
     "path": "j.serverTimestamp",
     "type": "time"
    }
   ]
  },
  "metadata.product.vendor_name": {
   "const": "WithSecure"
  },
  "metadata.product.name": {
   "const": "Elements Endpoint Protection"
  },
  "metadata.log_name": "j.description",
  "metadata.event_code": "evtype",
  "metadata.event_subtype": "d.alertType",
  "metadata.uid": "j.id",
  "metadata.throttled_count": {
   "path": "d.throttledCount",
   "type": "int"
  },
  "class_uid": {
   "const": 0
  },
  "class_name": {
   "const": "Base Event"
  },
  "category_uid": {
   "const": 0
  },
  "category_name": {
   "const": "Uncategorized"
  },
  "activity_id": {
   "const": 99
  },
  "severity_id": {
   "lookup": {
    "path": "j.severity",
    "type": "lower"
   },
   "table": {
    "info": 1,
    "warning": 3,
    "critical": 5
   },
   "default": 1
  },
  "message": {
   "first": [
    "j.message",
    "d.description",
    "j.description"
   ]
  },
  "device.hostname": "devname",
  "device.uid": "devid",
  "device.ip": {
   "path": "hostips",
   "type": "first"
  },
  "device.ips": "hostips",
  "device.org.name": "orgname",
  "actor.user.name": {
   "path": "user_raw",
   "type": "user"
  },
  "actor.user.domain": {
   "path": "user_raw",
   "type": "domain"
  },
  "actor.user.full_name": "user_raw",
  "actor.user.email_addr": "d.userPrincipalName",
  "policy.name": "d.profileName",
  "policy.uid": "d.profileId",
  "policy.version": "d.profileVersion"
 },
