{
 "slug": "withsecure-elements-syslog",
 "name": "WithSecure Elements · eventos de segurança (Elements Connector / syslog)",
 "vendor": "WithSecure",
 "product": "Elements Endpoint Protection",
 "description": "Eventos do WithSecure Elements enviados pelo Elements Connector: '<categoria> event [alertMeta@0 chave=\"valor\" ...]', puro, com cabeçalho syslog ou no envelope JSON {facility, hostname, message, priority}. Inclui o evento Windows (XML) embutido nos eventos de sistema.",
 "detect": {
  "re": "\\[alertMeta@\\d+ eventType="
 },
 "steps": [
  {
   "op": "json",
   "from": "$raw",
   "to": "env",
   "when": {
    "path": "$raw",
    "re": "^\\s*\\{"
   }
  },
  {
   "op": "syslog",
   "from": "$raw",
   "to": "sl",
   "when": {
    "path": "env",
    "exists": false
   },
   "optional": true
  },
  {
   "op": "set",
   "to": "m",
   "value": {
    "first": [
     "env.message",
     "sl.msg",
     "$raw"
    ]
   }
  },
  {
   "op": "regex",
   "from": "m",
   "to": "r",
   "name": "categoria + alertMeta",
   "pattern": "(?P<category>[A-Za-z][A-Za-z ]*?)\\s*\\[alertMeta@\\d+ (?P<sd>.*)\\]\\s*$"
  },
  {
   "op": "kv",
   "from": "r.sd",
   "to": "kv",
   "mode": "quoted"
  },
  {
   "op": "mojibake",
   "paths": [
    "kv"
   ]
  },
  {
   "op": "winxml",
   "from": "kv.details_eventXml",
   "to": "win",
   "optional": true
  },
  {
   "op": "set",
   "to": "hostips",
   "value": {
    "path": "kv.details_hostIpAddress",
    "type": "ips"
   }
  },
  {
   "op": "set",
   "to": "user_raw",
   "value": {
    "first": [
     "kv.details_userName",
     "kv.suser"
    ]
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "kv.details_clientTimestamp",
     "type": "epoch_ms"
    },
    {
     "path": "win.System.TimeCreatedSystemTime",
     "type": "time"
    },
    {
     "path": "kv.details_systemDataTimeCreated",
     "type": "epoch_s"
    },
    {
     "path": "sl.timestamp",
     "type": "time"
    }
   ]
  },
  "metadata.product.vendor_name": {
   "const": "WithSecure"
  },
  "metadata.product.name": {
   "const": "Elements Endpoint Protection"
  },
  "metadata.log_name": "r.category",
  "metadata.event_code": "kv.eventType",
  "metadata.event_subtype": "kv.details_alertType",
  "metadata.throttled_count": {
   "path": "kv.details_throttledCount",
   "type": "int"
  },
  "class_uid": {
   "const": 0
  },
  "class_name": {
   "const": "Base Event"
  },
  "activity_id": {
   "const": 99
  },
  "severity_id": {
   "lookup": "kv.details_alertType",
   "table": {
    "system_events_log.event.warning.added": 2
   },
   "default": 1
  },
  "message": {
   "first": [
    "kv.message",
    "kv.details_description",
    "r.category"
   ]
  },
  "device.hostname": "kv.deviceName",
  "device.uid": "kv.deviceId",
  "device.ip": {
   "path": "hostips",
   "type": "first"
  },
  "device.ips": "hostips",
  "device.org.name": "kv.accountName",
  "actor.user.name": {
   "path": "user_raw",
   "type": "user"
  },
  "actor.user.domain": {
   "path": "user_raw",
   "type": "domain"
  },
  "actor.user.full_name": "user_raw",
  "actor.user.email_addr": "kv.details_userPrincipalName",
  "policy.name": "kv.details_profileName",
  "policy.uid": "kv.details_profileId",
  "policy.version": "kv.details_profileVersion",
  "observer.hostname": {
   "first": [
    "env.hostname",
    "sl.hostname"
   ]
  },
  "observer.syslog_priority": {
   "first": [
    "env.priority",
    "sl.pri"
   ]
  }
 },
