    "metadata.log_name": "smtp-proxy",
    "unmapped.sender": "ghong@watchguard.com",
    "file.name": "2M-dlp-violates-end.txt"
   }
  },
  {
   "name": "IPS bloqueou (3000-0150) com cabeçalho syslog",
   "input": "<142>2026-10-08T12:00:01-03:00 FBX-01 firewall: msg_id=\"3000-0150\" Deny 1-Trusted 0-External 1440 tcp 20 61 10.0.1.2 192.168.130.126 55810 80 offset 5 A 447868619 win 54 signature_name=\"EXPLOIT Apple QuickTime FLIC Animation file buffer overflow -1-2\" signature_cat=\"Misc\" signature_id=\"1112464\" severity=\"4\" sig_vers=\"18.124\" msg=\"IPS detected\" (HTTP-00)",
   "expect": {
    "time": "2026-10-08T15:00:01.000Z",
    "class_uid": 4001,
    "activity_id": 5,
    "disposition": "Blocked",
    "action": "Denied",
    "severity_id": 4,
    "finding_info.title": "EXPLOIT Apple QuickTime FLIC Animation file buffer overflow -1-2",
    "finding_info.uid": "1112464",
    "message": "IPS detected",
    "device.hostname": "FBX-01",
    "policy.name": "HTTP-00"
   }
