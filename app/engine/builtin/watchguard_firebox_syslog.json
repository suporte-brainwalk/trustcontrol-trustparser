    "disposition": "Allowed",
    "src_endpoint.ip": "10.11.12.13",
    "src_endpoint.port": 58325,
    "dst_endpoint.ip": "192.168.1.10",
    "dst_endpoint.port": 60951,
    "connection_info.protocol_name": "tcp",
    "policy.name": "Inbound Policy-00",
    "device.hostname": "DEV01",
    "device.uid": "0011223344556",
    "src_endpoint.location.country": "USA",
    "unmapped.tcp_flags": "S"
   }
  },
  {
   "name": "proxy SMTP (exemplo do Log Catalog, cabeçalho BSD com ano)",
