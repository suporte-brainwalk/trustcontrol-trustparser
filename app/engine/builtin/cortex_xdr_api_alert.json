{
 "slug": "cortex-xdr-api-alert",
 "name": "Palo Alto Cortex XDR · alerta da API (get_alerts / get_alerts_multi_events)",
 "vendor": "Palo Alto Networks",
 "product": "Cortex XDR",
 "description": "Um alerta de reply.alerts[] de /public_api/v1/alerts/get_alerts ou /public_api/v2/alerts/get_alerts_multi_events, serializado em uma linha. Vira Detection Finding com endpoint (host_name, host_ip, endpoint_id), usuário, processo iniciador e causador (CGO), processo/arquivo alvo, rede (local/remoto), MITRE e decisão. Aceita events[] (v1), events{} e os campos de evento achatados em listas no topo (v2); description pode vir como lista de tokens (BIOC). Feito pela documentação (esquema OpenAPI) e fixtures públicos — validar com resposta real.",
 "basis": "docs",
 "priority": 100,
 "detect": {
  "all": [
   {
    "re": "^\\s*\\{"
   },
   {
    "contains": "\"alert_id\""
   },
   {
    "any": [
     {
      "contains": "\"detection_timestamp\""
     },
     {
      "contains": "\"local_insert_ts\""
     }
    ]
   }
  ]
 },
 "steps": [
  {
   "op": "json",
   "from": "$raw",
   "to": "j"
  },
  {
   "op": "set",
   "to": "e",
   "value": {
    "first": [
     "j.events.0",
     "j.events"
    ]
   }
  },
  {
   "op": "set",
   "to": "desc",
   "value": {
    "first": [
     {
      "path": "j.description",
      "type": "join: "
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "act",
   "value": {
    "first": [
     "j.action_pretty",
     "j.action"
    ]
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "j.detection_timestamp",
     "type": "time"
    },
    {
     "first": [
      {
       "path": "e.event_timestamp",
       "type": "time"
      },
      {
       "path": "j.event_timestamp",
       "type": [
        "first",
        "time"
       ]
      }
     ]
    },
    {
     "path": "j.local_insert_ts",
     "type": "time"
    }
   ]
  },
  "metadata.logged_time": {
   "path": "j.local_insert_ts",
   "type": "time"
  },
  "metadata.product.vendor_name": {
   "const": "Palo Alto Networks"
  },
  "metadata.product.name": {
   "const": "Cortex XDR"
  },
  "metadata.event_code": {
