{
 "slug": "watchguard-epdr-siemfeeder",
 "name": "WatchGuard EPDR · SIEMFeeder (CEF e LEEF)",
 "vendor": "WatchGuard",
 "product": "Endpoint Security (EPDR/EDR, ex-Panda Adaptive Defense)",
 "description": "Eventos do SIEMFeeder (Event Importer → syslog/Kafka/pasta) nos formatos CEF:1 ou LEEF:1.0 do fabricante 'WatchGuard Technologies, Ltd.' produto 'paps'. Alertas (alertmalware, alertpup, alertexploit…) e thalert (IOA) viram Detection Finding; exec/createprocessbyWMI/scriptlaunch/createremotethread/openlsass viram Process Activity; createpe/modifype/deletepe/renamepe… viram File System Activity; socket vira Network Activity; urldownload vira HTTP Activity; loginoutops vira Authentication; o resto (registro, sistema…) fica como Base Event com tudo em 'unmapped'. Aceita chaves CEF (Item*) e LEEF (MW*), valores com espaço e separador espaço ou TAB. Feito pela documentação (SIEMFeeder Event Guide) — validar com amostra real.",
 "basis": "docs",
 "priority": 100,
 "detect": {
  "re": "(?:CEF|LEEF):[\\d.]+\\|WatchGuard Technologies, Ltd\\.\\|paps\\|"
 },
 "steps": [
  {
   "op": "syslog",
   "from": "$raw",
   "to": "sl",
   "optional": true
  },
  {
   "op": "regex",
   "from": "$raw",
   "to": "hd",
   "name": "cabeçalho CEF/LEEF",
   "pattern": "(?P<fmt>CEF|LEEF):(?P<ver>[\\d.]+)\\|(?P<vendor>WatchGuard Technologies, Ltd\\.)\\|(?P<product>[^|]*)\\|(?P<pver>[^|]*)\\|(?P<name>[^|]*)\\|(?:(?P<name2>[^|=]*)\\|(?P<sev>\\d+)\\||)(?P<ext>.*)$"
  },
  {
   "op": "set",
   "to": "kvline",
   "value": {
    "template": "CEF:0|-|-|-|-|-|0|{hd.ext}"
   }
  },
  {
   "op": "cef",
   "from": "kvline",
   "to": "c"
  },
  {
   "op": "set",
   "to": "x",
   "value": "c.ext"
  },
  {
   "op": "set",
   "to": "nm",
   "value": {
    "path": "hd.name",
    "type": "lower"
   }
  },
  {
   "op": "set",
   "to": "act",
   "value": {
    "first": [
     "x.Action",
     "x.ExecutionStatus",
     "x.ToastResult"
    ]
   }
  },
  {
   "op": "set",
   "to": "mwname",
   "value": {
    "first": [
     {
      "path": "x.MWName",
      "type": "nil"
     },
     {
      "path": "x.ItemName",
      "type": "nil"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "mwpath",
   "value": {
    "first": [
     {
      "path": "x.MWPath",
      "type": "nil"
     },
     {
      "path": "x.ItemPath",
      "type": "nil"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "user_raw",
   "value": {
    "first": [
     {
      "path": "x.User",
      "type": "nil"
     },
     {
      "template": "{x.domain}\\{x.usrName}",
      "strict": true
     },
     {
      "path": "x.usrName",
      "type": "nil"
     }
    ]
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "x.Date",
     "type": "time"
    },
    {
     "path": "x.devTime",
     "type": "time"
    },
    {
     "path": "x.LocalDateTime",
     "type": "time"
    },
    {
     "path": "sl.timestamp",
     "type": "time"
    }
   ]
  },
  "metadata.product.vendor_name": {
   "const": "WatchGuard"
  },
  "metadata.product.name": {
   "const": "Endpoint Security (EPDR)"
  },
  "metadata.product.version": "hd.pver",
  "metadata.event_code": "hd.name",
  "metadata.event_subtype": "x.Op",
  "metadata.log_name": "hd.fmt",
  "class_uid": {
   "const": 0
  },
  "class_name": {
   "const": "Base Event"
  },
  "category_uid": {
   "const": 0
  },
  "category_name": {
   "const": "Uncategorized"
  },
  "activity_id": {
   "const": 99
  },
  "activity_name": {
   "const": "Other"
  },
  "severity_id": {
   "lookup": {
    "first": [
     "hd.sev",
     "x.sev"
    ]
   },
   "table": {
    "0": 1,
    "1": 1,
    "2": 1,
    "3": 2,
    "4": 2,
    "5": 2,
    "6": 2,
    "7": 3,
    "8": 4,
    "9": 4,
    "10": 5
   },
   "default": 1
  },
  "message": {
   "first": [
    {
     "template": "{hd.name} {x.Op} {x.Path}"
    },
    "hd.name"
   ]
  },
  "device.hostname": {
   "first": [
    {
     "path": "x.MachineName",
     "type": [
      "strip",
      "nil"
     ]
    },
    {
     "path": "x.HostName",
     "type": [
      "strip",
      "nil"
     ]
    },
    {
     "path": "x.identHostName",
     "type": [
      "strip",
      "nil"
     ]
    }
   ]
  },
  "device.ip": {
   "first": [
    {
     "path": "x.HostIp",
     "type": "ip"
    },
    {
     "path": "x.MachineIP",
     "type": "ip"
    },
    {
     "path": "x.src",
     "type": "ip"
    },
    {
     "path": "x.identSrc",
     "type": "ip"
    }
   ]
  },
  "device.uid": "x.MUID",
  "actor.user.name": {
   "path": "user_raw",
   "type": "user"
  },
  "actor.user.domain": {
   "path": "user_raw",
   "type": "domain"
  },
  "actor.user.full_name": "user_raw",
  "actor.process.path": {
   "first": [
    {
     "path": "x.ParentPath",
     "type": "nil"
    },
    {
     "path": "x.Path",
     "type": "nil"
    }
   ]
  },
  "actor.process.name": {
   "first": [
    {
     "path": "x.ParentPath",
     "type": [
      "nil",
      "basename"
     ]
    },
    {
     "path": "x.Path",
     "type": [
      "nil",
      "basename"
     ]
    }
   ]
  },
  "actor.process.file.hashes": {
   "list": [
    {
     "object": {
      "algorithm": {
       "first": [
        "x.ParentHash",
        "x.Hash"
       ],
       "type": [
        "hash_alg"
       ]
      },
      "value": {
       "first": [
        "x.ParentHash",
        "x.Hash"
       ]
      }
     }
    }
   ]
  },
  "unmapped.attacks": "x.TTPs"
 },
