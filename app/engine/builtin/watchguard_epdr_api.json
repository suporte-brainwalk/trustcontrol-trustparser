  "event_type",
  "rule_name",
  "rule_id",
  "rule_mitre",
  "rule_risk",
  "local_endpoint",
  "remote_endpoint",
  "local_ip_address",
  "remote_ip_address",
  "direction",
  "protocol",
  "platform_id",
  "device_type",
  "description",
  "source_ip",
  "source_machine_name"
 ],
 "require": [
  "time",
  "device.hostname"
 ],
 "tests": [
  {
   "name": "exemplo da documentação (união de campos, IPs entre aspas)",
   "input": "{\"accessed_data\":true,\"action\":10,\"date\":\"2020-11-20T20:27:18.725Z\",\"device_id\":\"8b7205bc-60e0-45a0-9956-b17b6a8673f6\",\"site_id\":\"8b7205bc-60e0-45a0-9956-b17b6a8673f6\",\"event_id\":69608597,\"hash\":\"009a9b4ff00946f9a5a5659dfe9086da\",\"host_name\":\"WIN_SERVER_6\",\"item_name\":\"NameMalware\",\"path\":\"ThreatPath\",\"user_name\":\"Username\",\"was_run\":true,\"rule_mitre\":\"tactic: TA0006, technique: T1003\",\"local_endpoint\":{},\"remote_endpoint\":{},\"network_attack\":null,\"local_ip_address\":\"192.168.1.1\",\"remote_ip_address\":\"192.168.10.1\"}",
   "expect": {
    "time": "2020-11-20T20:27:18.725Z",
    "class_uid": 2004,
    "finding_info.title": "NameMalware",
    "metadata.uid": "69608597",
    "device.hostname": "WIN_SERVER_6",
    "file.path": "ThreatPath",
    "file.hashes.0.algorithm": "MD5",
    "disposition": "Detected",
    "src_endpoint.ip": "192.168.1.1",
    "dst_endpoint.ip": "192.168.10.1",
    "actor.user.name": "Username",
    "unmapped.attacks": "tactic: TA0006, technique: T1003"
   }
  },
