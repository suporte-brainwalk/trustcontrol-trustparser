   "input": "{\"event_id\":71234580,\"date\":\"2026-10-08T13:00:00.000Z\",\"endpoint_event_date\":\"2026-10-08T12:58:12.000Z\",\"filed_date\":\"2026-10-08T13:00:00.000Z\",\"device_id\":\"00000000-0000-4000-8000-0000000000a3\",\"host_name\":\"SRV-0001\",\"rule_name\":\"Credential dumping via LSASS access\",\"rule_id\":\"00000000-0000-4000-8000-0000000000b1\",\"rule_mitre\":\"[{tactic: \\\"TA0006\\\", technique: \\\"T1003\\\"}]\",\"rule_risk\":2,\"action\":2,\"status\":1,\"count\":3,\"since_until_filed\":\"0.00:01:48\"}",
