 },
 "cases": [
  {
   "name": "deteccao-com-arquivo",
   "when": {
    "all": [
     {
      "path": "title",
      "exists": true
     },
     {
      "any": [
       {
        "path": "j.path",
        "exists": true
       },
       {
        "path": "j.hash",
        "exists": true
       }
      ]
     },
     {
      "path": "j.rule_mitre",
      "exists": false
     }
    ]
   },
   "map": {
    "malware": {
     "list": [
      {
       "object": {
        "name": {
         "first": [
          {
           "path": "j.item_name",
           "type": "nil"
          },
          {
           "path": "j.malware_name",
           "type": "nil"
          }
         ]
        },
        "classification": {
         "lookup": {
          "path": "j.malware_type",
          "type": "str"
         },
         "table": {
          "101": "Virus",
          "102": "Worm",
          "103": "Trojan",
          "108": "Spyware",
          "109": "Adware",
          "112": "PUP",
          "113": "Hacking Tool",
          "120": "Rootkit",
          "121": "Backdoor",
          "123": "Malicious URL"
         }
        }
       }
      }
     ]
    }
   }
  },
  {
   "name": "indicador-de-ataque",
   "when": {
    "any": [
     {
      "path": "j.rule_mitre",
      "exists": true
     },
     {
      "path": "j.rule_risk",
      "exists": true
     }
    ]
   },
   "map": {
    "disposition": {
     "lookup": {
      "path": "j.action",
      "type": "str"
     },
     "table": {
      "1": "Detected",
      "2": "Blocked"
     },
     "default": "Detected"
    },
    "disposition_id": {
     "lookup": {
      "path": "j.action",
      "type": "str"
     },
     "table": {
      "1": 15,
      "2": 2
     },
     "default": 15
    },
    "action": {
     "lookup": {
      "path": "j.action",
      "type": "str"
     },
     "table": {
      "2": "Denied"
     }
    },
    "action_id": {
     "lookup": {
      "path": "j.action",
      "type": "str"
     },
     "table": {
      "2": 2
     }
    },
    "finding_info.types": {
     "list": [
      {
       "const": "Indicator of Attack"
      }
     ]
    },
    "unmapped.count": "j.count"
   }
  },
  {
   "name": "rede-de-entrada",
   "when": {
    "path": "j.direction",
    "in": [
     "1"
    ]
   },
   "map": {
    "src_endpoint.ip": {
     "first": [
      {
       "path": "re.ip_address",
       "type": "ip"
      },
      {
       "path": "j.remote_ip_address",
       "type": "ip"
      },
      {
       "path": "j.source_ip",
       "type": "ip"
      }
     ]
    },
    "src_endpoint.port": {
     "path": "re.port",
     "type": "int"
    },
    "dst_endpoint.ip": {
     "first": [
      {
       "path": "le.ip_address",
       "type": "ip"
      },
      {
       "path": "j.local_ip_address",
       "type": "ip"
      }
     ]
    },
    "dst_endpoint.port": {
     "path": "le.port",
     "type": "int"
    }
   },
   "unset": [
    "src_endpoint",
    "dst_endpoint"
   ]
  }
 ],
 "unmapped": [
  "j"
 ],
 "unmapped_drop": [
  "event_id",
  "date",
  "device_id",
  "host_name",
  "domain",
  "ip_address",
  "user_name",
  "item_name",
  "malware_name",
