{
 "slug": "watchguard-epdr-api-json",
 "name": "WatchGuard EPDR · API de eventos de segurança (JSON)",
 "vendor": "WatchGuard",
 "product": "Endpoint Security (EPDR/EDR, ex-Panda Adaptive Defense)",
 "description": "Um item de 'data' do GET /securityevents/{tipo}/export/{período} da Endpoint Security Management API (WatchGuard Cloud), serializado em uma linha. Malware, PUP, programas bloqueados, exploits, IOA, ataques de rede, conexões e dispositivos bloqueados viram Detection Finding com equipamento, usuário, arquivo/hash, endpoints de rede e decisão (campo action). Feito pela documentação (exemplo oficial é inválido e mistura todos os tipos) — validar com resposta real.",
 "basis": "docs",
 "priority": 100,
 "detect": {
  "all": [
   {
    "re": "^\\s*\\{"
   },
   {
    "contains": "\"event_id\""
   },
   {
    "any": [
     {
      "contains": "\"host_name\""
     },
     {
      "contains": "\"device_id\""
     }
    ]
   },
   {
    "any": [
     {
      "contains": "\"item_name\""
     },
     {
      "contains": "\"malware_name\""
     },
     {
      "contains": "\"rule_name\""
     },
     {
      "contains": "\"network_attack\""
     },
     {
      "contains": "\"protection_mode\""
     },
     {
      "contains": "\"detected_by\""
     },
     {
      "contains": "\"security_event_date\""
     },
     {
      "contains": "\"was_run\""
     },
     {
      "contains": "\"malware_type\""
     }
    ]
   },
   {
    "not": {
     "contains": "\"alert_id\""
    }
   }
  ]
 },
 "steps": [
  {
   "op": "json",
   "from": "$raw",
   "to": "j"
  },
  {
   "op": "json",
   "from": "j.local_endpoint",
   "to": "le",
   "optional": true
  },
  {
   "op": "json",
   "from": "j.remote_endpoint",
   "to": "re",
   "optional": true
  },
  {
   "op": "set",
   "to": "title",
   "value": {
    "first": [
     {
      "path": "j.item_name",
      "type": "nil"
     },
     {
      "path": "j.malware_name",
      "type": "nil"
     },
     {
      "path": "j.network_attack",
      "type": "nil"
     },
     {
      "path": "j.rule_name",
      "type": "nil"
     },
     {
      "path": "j.description",
      "type": "nil"
     }
    ]
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "j.date",
     "type": "time"
    },
    {
     "path": "j.security_event_date",
     "type": "time"
    },
    {
     "path": "j.endpoint_event_date",
     "type": "time"
    },
    {
     "path": "j.filed_date",
     "type": "time"
    }
   ]
  },
  "metadata.product.vendor_name": {
   "const": "WatchGuard"
  },
  "metadata.product.name": {
   "const": "Endpoint Security (EPDR)"
  },
  "metadata.uid": {
   "path": "j.event_id",
   "type": "str"
  },
  "metadata.event_code": {
   "first": [
    {
     "path": "j.event_type",
     "type": "str"
    },
    {
     "const": "security_event"
    }
   ]
  },
  "metadata.event_subtype": {
   "lookup": {
    "path": "j.event_type",
    "type": "str"
   },
   "table": {
    "0": "Malware",
    "1": "Exploit",
    "2": "PUPs",
    "3": "Blocked Item",
    "6": "Lock Plus Advanced Security",
    "7": "Lock Plus Application Control",
    "8": "Application Control",
    "10": "Network Attack Activity"
   }
  },
  "class_uid": {
   "const": 2004
  },
  "class_name": {
   "const": "Detection Finding"
  },
  "category_uid": {
   "const": 2
  },
  "category_name": {
   "const": "Findings"
  },
  "activity_id": {
   "const": 1
  },
  "activity_name": {
