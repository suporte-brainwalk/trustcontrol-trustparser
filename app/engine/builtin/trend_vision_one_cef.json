    "activity_id": 1,
    "status": "Success",
    "user.name": "Root account",
    "user.email_addr": "admin@example.com",
    "src_endpoint.ip": "10.1.1.1",
    "logon_process.name": "Console",
    "unmapped.Role": "Master Administrator"
   }
  },
  {
   "name": "Workbench com marca antiga 'Trend Micro|Vision One' e cabeçalho syslog (sintético)",
