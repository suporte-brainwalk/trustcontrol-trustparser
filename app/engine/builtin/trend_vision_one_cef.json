    "finding_info.tactics": [
     "TA0002",
     "TA0006"
    ],
    "finding_info.techniques": [
     "T1003.001",
     "T1059.001"
    ],
    "device.hostname": "ip-10-209-120-47.ap-northeast-1.compute.internal",
    "src_endpoint.ip": "8.8.8.8",
