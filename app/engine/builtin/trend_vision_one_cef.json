    "http_request.url.url_string": "http://35.247.144.219/"
   }
  },
  {
   "name": "auditoria de conta: login (construído da tabela CEF oficial)",
   "input": "CEF:0|TrendAI™|TrendAI Vision One™|1.0.0|900003|TrendAI Vision One™ Account Audit Log|2|cat=Sign in and sign out cs1=Root account cs1Label=Account cs2=Master Administrator cs2Label=Role cs3=Sign in cs3Label=Activity cn1=1 cn1Label=Result cn2=0 cn2Label=Source msg={\"IP address\": \"10.1.1.1\", \"Identifier\": {\"id\":\"0e9b00aa-6ee4-4f83-9e42-dd83e19a5e60\",\"type\":\"managedAccount\",\"name\":\"Root Account\",\"email\":\"admin@example.com\",\"subType\":\"local\"}} rt=2024-09-23T17:18:42Z TrendMicroV1CompanyID=68960c94-9be6-4343-a4ca-6408de7aa331",
