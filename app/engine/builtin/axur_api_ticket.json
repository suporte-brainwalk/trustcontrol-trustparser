{
 "slug": "axur-api-ticket",
 "name": "Axur · tickets, detecções e vazamentos (API/webhook JSON)",
 "vendor": "Axur",
 "product": "Axur Platform (Digital Risk Protection)",
 "description": "Um objeto JSON por linha vindo da Axur: ticket de GET /tickets-api/tickets (tickets[]) ou /tickets-api/ticket/{key} (blocos ticket + detection, chaves com ponto como 'open.date'), webhook ticket.* (event + ticket) e detecção de vazamento de credencial/cartão (item de /exposure-api ou de detections[] do webhook exposure.*). Tudo vira Detection Finding (tipo, referência/URL, domínio, IP, status, resolução, risco). Senha, número de cartão e CVV NUNCA vão para campos canônicos nem para 'unmapped'. Feito pela documentação (OpenAPI 1.0.83) — validar com resposta real.",
 "basis": "docs",
 "priority": 100,
 "detect": {
  "all": [
   {
    "re": "^\\s*\\{"
   },
   {
    "any": [
     {
      "contains": "\"ticketKey\""
     },
     {
      "re": "\\\"type\\\"\\s*:\\s*\\\"(?:ticket|exposure)\\.[\\w.-]+\\\""
     },
     {
      "re": "\\\"category\\\"\\s*:\\s*\\\"(?:credential|credit-cards?)\\\""
     },
     {
      "contains": "\"credential.types\""
     }
    ]
   }
  ]
 },
 "steps": [
  {
   "op": "json",
   "from": "$raw",
   "to": "j"
  },
  {
   "op": "set",
   "to": "tk",
   "value": {
    "first": [
     "j.ticket"
    ]
   }
  },
  {
   "op": "set",
   "to": "dt",
   "value": {
    "first": [
     "j.detection"
    ]
   }
  },
  {
   "op": "set",
   "to": "cr",
   "value": {
    "first": [
     "j.credential",
     "j.card"
    ]
   }
  },
  {
   "op": "set",
   "to": "ref",
   "value": {
    "first": [
     {
      "path": "tk.reference",
      "type": "nil"
     },
     {
      "path": "j.snapshots",
      "type": "key:digitalLocation"
     },
     {
      "path": "cr",
      "type": "key:access.url"
     },
     {
      "path": "j",
      "type": "key:access.url"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "dtype",
   "value": {
    "first": [
     {
      "path": "dt.type",
      "type": "nil"
     },
     {
      "path": "tk.type",
      "type": "nil"
     },
     {
      "path": "j.category",
      "type": "nil"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "leak_user",
   "value": {
    "first": [
     {
      "path": "cr.user",
      "type": "nil"
     },
     {
      "path": "j.user",
      "type": "nil"
     }
    ]
   }
  },
  {
   "op": "set",
   "to": "safe",
   "value": {
    "object": {
     "user_type": {
      "first": [
       {
        "path": "cr",
        "type": "key:user.type"
       },
       {
        "path": "j",
        "type": "key:user.type"
       }
      ]
     },
     "password_type": {
      "first": [
       {
        "path": "cr",
        "type": "key:password.type"
       },
       {
        "path": "j",
        "type": "key:password.type"
       }
      ]
     },
     "password_length": {
      "first": [
       {
        "path": "cr",
        "type": "key:password.length"
       },
       {
        "path": "j",
        "type": "key:password.length"
       }
      ]
     },
     "access_url": {
      "first": [
       {
        "path": "cr",
        "type": "key:access.url"
       },
       {
        "path": "j",
        "type": "key:access.url"
       }
      ]
     },
     "access_host": {
      "path": "j",
      "type": "key:access.host"
     },
     "credential_types": {
      "first": [
       "cr.types",
       {
        "path": "j",
        "type": "key:credential.types"
       }
      ]
     },
     "source_name": {
      "first": [
       {
        "path": "cr",
        "type": "key:source.name"
       },
       {
        "path": "j",
        "type": "key:source.name"
       }
      ]
     },
     "card_bin": {
      "first": [
       "cr.bin",
       "j.bin"
      ]
     },
     "card_brand": {
      "first": [
       {
        "path": "cr",
        "type": "key:brand"
       },
       {
        "path": "j",
        "type": "key:card.brand"
       }
      ]
     }
    }
   }
  }
 ],
 "map": {
  "time": {
   "first": [
    {
     "path": "tk",
     "type": [
      "key:last-update.date",
      "time"
     ]
    },
    {
     "path": "dt",
     "type": [
      "key:close.date",
      "time"
     ]
    },
    {
     "path": "dt",
     "type": [
      "key:open.date",
      "time"
     ]
    },
    {
     "path": "tk",
     "type": [
      "key:creation.date",
      "time"
     ]
    },
    {
     "path": "j.event.date",
     "type": "time"
    },
    {
     "path": "j.updated",
     "type": "time"
    },
    {
     "path": "j.created",
     "type": "time"
    },
    {
     "path": "j.detectionDate",
     "type": "time"
    }
   ]
  },
  "metadata.product.vendor_name": {
   "const": "Axur"
  },
  "metadata.product.name": {
   "const": "Axur Platform"
  },
  "metadata.event_code": {
   "first": [
    "j.event.type",
    {
     "path": "dtype",
     "type": "nil"
    },
    {
     "const": "ticket"
    }
   ]
  },
  "metadata.event_subtype": "dtype",
  "metadata.uid": {
   "first": [
    "tk.ticketKey",
    "tk.key",
    "j.id"
   ]
  },
  "metadata.tenant_uid": {
   "first": [
    "tk.customerKey",
    "tk.customer",
    "j.customer"
   ]
  },
  "metadata.sequence": "j.event.sequence",
  "class_uid": {
   "const": 2004
  },
  "class_name": {
   "const": "Detection Finding"
  },
  "category_uid": {
   "const": 2
  },
  "category_name": {
   "const": "Findings"
  },
  "activity_id": {
   "const": 1
  },
  "activity_name": {
   "const": "Create"
  },
  "severity_id": {
   "first": [
    {
     "lookup": {
      "path": "dt.criticality",
      "type": "lower"
     },
     "table": {
      "high": 4,
      "medium": 3,
      "low": 2
     }
    },
    {
     "lookup": {
      "regex": "^0?\\.(\\d)",
      "path": {
       "path": "dt",
       "type": "key:prediction.risk"
      }
     },
     "table": {
      "0": 1,
      "1": 1,
      "2": 2,
      "3": 2,
      "4": 2,
      "5": 3,
      "6": 3,
      "7": 3,
      "8": 4,
      "9": 4
     }
    },
    {
     "lookup": {
      "regex": "^(1)(?:\\.0*)?$",
      "path": {
       "path": "dt",
       "type": "key:prediction.risk"
      }
     },
     "table": {
      "1": 4
     }
    },
    {
     "const": 3
    }
   ]
  },
  "finding_info.uid": {
   "first": [
    "tk.ticketKey",
    "tk.key",
    "j.id"
   ]
  },
  "finding_info.title": {
   "first": [
    {
     "template": "{dtype}: {ref}",
     "strict": true
    },
    {
     "template": "{dtype}: {leak_user}",
     "strict": true
    },
    "dtype",
    {
     "const": "Axur"
    }
   ]
  },
  "finding_info.types": {
   "list": [
    "dtype"
   ]
  },
  "finding_info.src_url": "ref",
  "finding_info.created_time": {
   "first": [
    {
     "path": "tk",
     "type": [
      "key:creation.date",
      "time"
     ]
    },
    {
     "path": "j.created",
     "type": "time"
    }
   ]
  },
  "finding_info.first_seen_time": {
   "first": [
    {
     "path": "dt",
     "type": [
      "key:open.date",
      "time"
     ]
    },
    {
     "path": "j.detectionDate",
     "type": "time"
    }
   ]
  },
  "finding_info.modified_time": {
   "first": [
    {
     "path": "tk",
     "type": [
      "key:last-update.date",
      "time"
     ]
    },
    {
     "path": "j.updated",
     "type": "time"
    }
   ]
  },
  "finding_info.status": {
   "first": [
    {
     "path": "dt.status",
     "type": "nil"
    },
    {
     "path": "tk.status",
     "type": "nil"
    },
    {
     "path": "j.status",
     "type": "nil"
    }
   ]
  },
  "finding_info.verdict": {
   "first": [
    {
     "path": "dt.resolution",
     "type": "nil"
    },
    {
     "path": "tk.resolution",
     "type": "nil"
    }
   ]
  },
  "finding_info.risk_score": {
   "path": "dt",
   "type": [
    "key:prediction.risk",
    "float"
   ]
  },
  "status_detail": {
   "path": "dt",
   "type": [
    "key:resolution.reason",
    "nil"
   ]
  },
  "message": {
   "first": [
    {
     "template": "Axur {dtype}: {ref}",
     "strict": true
    },
    {
     "template": "Axur {dtype}: {leak_user}",
     "strict": true
    },
    {
     "template": "Axur {j.event.type}",
     "strict": true
    }
   ]
  },
  "dst_endpoint.hostname": {
   "first": [
    {
     "path": "dt.host",
     "type": "nil"
    },
    {
     "path": "ref",
     "type": "url_host"
    }
   ]
  },
  "dst_endpoint.ip": {
   "path": "dt.ip",
   "type": "ip"
  },
  "dst_endpoint.domain": {
   "path": "dt.domain",
   "type": "nil"
  },
  "dst_endpoint.isp": {
   "path": "dt.isp",
   "type": "nil"
  },
  "http_request.url.url_string": {
   "path": "ref",
   "type": "nil"
  },
  "user.name": {
   "path": "leak_user",
   "type": "user"
  },
  "user.email_addr": {
   "regex": "^([^@\\s]+@[^@\\s]+)$",
   "path": "leak_user"
  },
  "user.full_name": "leak_user",
  "unmapped.assets": {
   "first": [
    "dt.assets",
    "tk.assets",
    "j.assets"
   ]
  },
  "unmapped.tags": {
   "first": [
    "tk.tags",
    "j.tags"
   ]
  }
 },
 "cases": [
  {
   "name": "webhook-ticket",
   "when": {
    "path": "j.event.type",
    "startswith": "ticket."
   },
   "map": {
    "activity_id": {
     "lookup": "j.event.type",
     "table": {
      "ticket.created": 1,
      "ticket.detection.opened": 1,
      "ticket.detection.closed": 3
     },
     "default": 2
    },
    "activity_name": {
     "lookup": "j.event.type",
     "table": {
      "ticket.created": "Create",
      "ticket.detection.opened": "Create",
      "ticket.detection.closed": "Close"
     },
     "default": "Update"
    }
   }
  },
  {
   "name": "vazamento",
   "when": {
    "any": [
     {
      "path": "j.category",
      "exists": true
     },
     {
      "path": "leak_user",
      "exists": true
     },
     {
      "path": "j.event.type",
      "startswith": "exposure."
     }
    ]
   },
   "map": {
    "finding_info.types": {
     "list": [
      "dtype",
      {
       "path": "j",
       "type": [
        "key:credential.types",
        "first"
       ]
      },
      {
       "path": "cr.types",
       "type": "first"
      }
     ]
    },
    "severity_id": {
     "lookup": {
      "path": "j.status",
      "type": "upper"
     },
     "table": {
      "NEW": 4,
      "IN_TREATMENT": 4,
      "SOLVED": 2,
      "DISCARDED": 1
     },
     "default": 3
    },
    "metadata.log_name": {
     "const": "exposure"
    }
   }
  },
  {
   "name": "ticket",
   "when": {
    "path": "tk",
    "exists": true
   },
   "map": {
    "metadata.log_name": {
     "const": "tickets"
    },
    "activity_id": {
     "lookup": {
      "path": "dt.status",
      "type": "nil"
     },
     "table": {
      "closed": 3
     },
     "default": 2
    },
    "activity_name": {
     "lookup": {
      "path": "dt.status",
      "type": "nil"
     },
     "table": {
      "closed": "Close"
     },
     "default": "Update"
    }
   }
  }
 ],
 "unmapped": [
  "tk",
  "dt",
  "safe",
  "j"
 ],
 "unmapped_drop": [
  "password",
  "password.value",
  "card",
  "card.number",
  "card.cvv",
  "card.month",
  "card.year",
  "cvv",
  "credential.password.value",
  "credential.password.value.masked",
  "sha256CreditCardNumberHash",
  "ticket",
  "detection",
  "credential",
  "event",
  "reference",
  "ticketKey",
  "key",
  "customerKey",
  "customer",
  "type",
  "status",
  "resolution",
  "host",
  "ip",
  "domain",
  "isp",
  "assets",
  "tags",
  "id",
  "user",
  "created",
  "updated",
  "category",
  "detections"
 ],
 "require": [
  "time",
  "metadata.uid"
 ],
