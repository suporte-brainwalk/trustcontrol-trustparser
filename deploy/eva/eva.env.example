# EVA — orquestrador (copiar para /root/trustparser/secrets/eva.env, chmod 600). Nunca versionar o arquivo real.
# Banco do Trust Parser (mesmas credenciais de /root/trustparser/secrets/postgres.env; o usuário precisa poder criar
# bancos: as instâncias de verificação antes/depois usam trustparser_eva_antes/_depois e os testes trustparser_eva_test).
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@parser-db:5432/trustparser

# Caixa eva-trustparser@ no postfix-mail (gravada aqui por deploy/eva/setup-mailbox.sh; login só da trustparser_net)
EVA_MAIL_PASSWORD=

# Leitura de dados pela API v1 com a chave protegida da EVA (o agente nunca vê):
#   docker exec parser-app flask --app app:create_app api-chave-eva  (ou api_keys.ensure_eva_key())
EVA_API_KEY=

# IA: a chave dedicada e o modelo ficam em /root/trustparser/secrets/openrouter.env (OPENROUTER_API_KEY, OPENROUTER_MODEL);
# o orquestrador relê o arquivo a cada uso (rotação sem reinício). Só defina aqui para sobrepor.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=xiaomi/mimo-v2.6-pro

# Avisos operacionais (EVA parada, IA, caixa, disco, rollback)
EVA_ALERT_TO=suporte.trustcontrol@brainwalk.com.br

# Opcionais (padrões já corretos para este servidor)
# EVA_PORTAL_URL=https://trustparser.trustcontrol.nuvem.tec.br
# EVA_APP_SERVICE=parser-app
# EVA_INGEST_SERVICE=parser-ingest
# EVA_APP_IMAGE=trustparser-app
# EVA_APP_ENV=/root/trustparser/secrets/app.env
# EVA_API_BASE=http://parser-app:8000/api/v1
# EVA_POLL_SECONDS=60
# EVA_REQUIRE_WORKER_HEARTBEAT=1
# EVA_DEMO_EXTRA_SENDERS=           # atendidos também no modo demonstração (separados por vírgula)
# Instância de teste (E2E): EVA_DRY_RUN_DEPLOY=1, EVA_OUTBOUND_REDIRECT=<caixa>, EVA_IMAP_KEYWORD=EvaE2E, EVA_STATE_DIR=/srv/eva-e2e
