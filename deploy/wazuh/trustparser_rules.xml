<!--
  Regras do Trust Parser para Wazuh 4.x. Copiar para /var/ossec/etc/rules/trustparser_rules.xml e reiniciar o manager.
  IDs 100500–100599 (faixa de regras personalizadas). Ajuste níveis conforme a política do SOC.
  Severidade do Trust Parser (tp.severity_id): 1 Informativa, 2 Baixa, 3 Média, 4 Alta, 5 Crítica.
-->
<group name="trustparser,">

  <rule id="100500" level="0">
    <decoded_as>trustparser</decoded_as>
    <description>Trust Parser: eventos normalizados (agrupamento).</description>
  </rule>

  <rule id="100501" level="0">
    <decoded_as>json</decoded_as>
    <field name="tp.product">^trustparser$</field>
    <description>Trust Parser: eventos normalizados via JSON sem cabeçalho (agente/arquivo).</description>
  </rule>

  <rule id="100510" level="3">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.severity_id" type="pcre2">^3$</field>
    <description>Trust Parser [$(tp.tenant)]: $(tp.source_vendor) $(tp.class) - $(tp.message)</description>
  </rule>

  <rule id="100511" level="7">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.severity_id" type="pcre2">^4$</field>
    <description>Trust Parser [$(tp.tenant)] ALTA: $(tp.source_vendor) $(tp.class) - $(tp.message)</description>
    <group>trustparser_high,</group>
  </rule>

  <rule id="100512" level="12">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.severity_id" type="pcre2">^[56]$</field>
    <description>Trust Parser [$(tp.tenant)] CRÍTICA: $(tp.source_vendor) $(tp.class) - $(tp.message)</description>
    <group>trustparser_critical,</group>
  </rule>

  <rule id="100520" level="5">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.class_uid">^3002$</field>
    <field name="tp.status">^Failure$</field>
    <description>Trust Parser [$(tp.tenant)]: falha de autenticação de $(dstuser) em $(tp.host)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100521" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100520</if_matched_sid>
    <same_field>tp.host</same_field>
    <description>Trust Parser [$(tp.tenant)]: possível força bruta em $(tp.host)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100530" level="10">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.class_uid">^2004$</field>
    <field name="tp.disposition">^Quarantined$|^Blocked$|^Detected$</field>
    <description>Trust Parser [$(tp.tenant)]: detecção $(tp.message) em $(tp.host) ($(tp.disposition))</description>
    <group>malware,</group>
  </rule>

  <rule id="100540" level="4">
    <if_sid>100500, 100501</if_sid>
    <field name="tp.disposition">^Blocked$</field>
    <description>Trust Parser [$(tp.tenant)]: bloqueio $(tp.source_vendor) - $(tp.message)</description>
  </rule>

</group>
